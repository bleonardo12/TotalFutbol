// Hito 1 (la espina) + Hito 2 (disputas) + Hito 3 (fair-play) + Hito 4
// (temporadas) — entidades nucleo. Fichas de desafio se agregan en el
// hito posterior (ver docs/arquitectura.md §8).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RolUsuario {
  JUGADOR
  ADMIN
}

/// Capitan/es de equipo. La identidad ancla en el telefono verificado por OTP.
model User {
  id        String     @id @default(cuid())
  telefono  String     @unique
  email     String?    @unique
  nombre    String?
  rol       RolUsuario @default(JUGADOR)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  equiposCapitaneados   Team[]                 @relation("CapitanDeEquipo")
  integraciones         TeamMember[]
  reportesComoLocal     Match[]                @relation("ReporterLocal")
  reportesComoVisitante Match[]                @relation("ReporterVisitante")
  reportesEnviados      MatchReport[]
  handshakesGenerados   MatchHandshake[]
  disputasResueltas     Dispute[]
  evidenciasSubidas     DisputeEvidence[]
  respuestasPoll        DisputePollRespuesta[]
  incidentesFlagged     MatchIncidentFlag[]
  noShowsFlagged        MatchNoShowFlag[]

  @@map("users")
}

/// Codigo OTP por telefono (login/registro). El codigo se guarda hasheado;
/// nunca en texto plano.
model OtpCode {
  id         String   @id @default(cuid())
  telefono   String
  codigoHash String
  expiraEn   DateTime
  intentos   Int      @default(0)
  usado      Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([telefono, usado])
  @@map("otp_codes")
}

enum EstadoEquipo {
  PROVISIONAL
  RANKEADO
}

/// La unidad rankeada. rating/rd/volatilidad son la materializacion
/// del ultimo asiento de RatingLedger; la fuente de verdad es el ledger.
model Team {
  id        String       @id @default(cuid())
  nombre    String
  capitanId String
  capitan   User         @relation("CapitanDeEquipo", fields: [capitanId], references: [id])
  estado    EstadoEquipo @default(PROVISIONAL)

  rating      Float @default(1500)
  rd          Float @default(350)
  volatilidad Float @default(0.06)

  /// Un solo numero de confianza (0-1000, arranque 900, concepto.md §11).
  /// Materializado desde fair_play_ledger con decay temporal — igual que
  /// rating se materializa desde rating_ledger.
  fairPlay Float @default(900)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  integrantes         TeamMember[]
  desafiosHechos      Challenge[]            @relation("EquipoDesafiante")
  desafiosRecibidos   Challenge[]            @relation("EquipoDesafiado")
  partidosComoLocal   Match[]                @relation("EquipoLocal")
  partidosComoVisita  Match[]                @relation("EquipoVisitante")
  reportesEnviados    MatchReport[]
  asientosDeRating    RatingLedger[]
  handshakesGenerados MatchHandshake[]
  evidenciasSubidas   DisputeEvidence[]
  respuestasPoll      DisputePollRespuesta[]
  eventosFairPlay     FairPlayLedger[]
  incidentesFlagged   MatchIncidentFlag[]
  noShowsFlagged      MatchNoShowFlag[]
  campeonatos         Campeonato[]

  @@index([rating])
  @@map("teams")
}

enum RolIntegrante {
  CAPITAN
  JUGADOR
}

/// Plantel progresivo: el equipo nace con nombre + capitan, el resto se suma despues.
model TeamMember {
  id        String        @id @default(cuid())
  teamId    String
  team      Team          @relation(fields: [teamId], references: [id])
  userId    String
  user      User          @relation(fields: [userId], references: [id])
  rol       RolIntegrante @default(JUGADOR)
  createdAt DateTime      @default(now())

  @@unique([teamId, userId])
  @@map("team_members")
}

/// Cancha/sede. Sus coordenadas alimentan las zonas emergentes del ranking (§15).
model Venue {
  id         String   @id @default(cuid())
  nombre     String
  lat        Float
  lng        Float
  verificada Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  desafios   Challenge[]
  partidos   Match[]
  handshakes MatchHandshake[]

  @@map("venues")
}

enum CantidadJugadores {
  F5
  F6
  F7
  F8
  F11
}

enum Superficie {
  SINTETICO
  SALON
  PASTO
  TIERRA
}

enum EstadoDesafio {
  PROPUESTO
  ACEPTADO
  RECHAZADO
  EXPIRADO
}

/// Pacto a distancia (etapa 2, §2). No mueve rating por si solo: recien
/// se vuelve vinculante cuando se firma el Match por QR en la cancha.
model Challenge {
  id           String @id @default(cuid())
  desafianteId String
  desafiante   Team   @relation("EquipoDesafiante", fields: [desafianteId], references: [id])
  desafiadoId  String
  desafiado    Team   @relation("EquipoDesafiado", fields: [desafiadoId], references: [id])

  cantidadJugadores CantidadJugadores
  superficie        Superficie
  sedeId            String?
  sede              Venue?            @relation(fields: [sedeId], references: [id])
  fechaPropuesta    DateTime?

  estado    EstadoDesafio @default(PROPUESTO)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  partido Match?

  @@map("challenges")
}

/// Maquina de estados del partido (concepto.md §8):
/// PACTADO (solo etapa 2) -> FIRMADO (QR en cancha) -> EN_JUEGO -> REPORTADO
/// -> CONFIRMADO -> LIQUIDADO, con ramas EN_DISPUTA y SUSPENDIDO/VOID.
enum EstadoPartido {
  PACTADO
  FIRMADO
  EN_JUEGO
  REPORTADO
  CONFIRMADO
  EN_DISPUTA
  LIQUIDADO
  SUSPENDIDO
  VOID
}

enum OutcomePartido {
  GANA_LOCAL
  GANA_VISITANTE
  EMPATE
}

/// Ticket efimero del handshake: un lado genera el codigo/QR, el otro lo
/// consume. El Match recien nace (FIRMADO) cuando se consume — antes de
/// eso no hay "partido", solo un codigo esperando ser escaneado.
model MatchHandshake {
  id            String @id @default(cuid())
  codigo        String @unique
  equipoLocalId String
  equipoLocal   Team   @relation(fields: [equipoLocalId], references: [id])
  generadoPorId String
  generadoPor   User   @relation(fields: [generadoPorId], references: [id])

  cantidadJugadores CantidadJugadores
  superficie        Superficie
  sedeId            String?
  sede              Venue?            @relation(fields: [sedeId], references: [id])

  expiraEn    DateTime
  consumidoEn DateTime?
  createdAt   DateTime  @default(now())

  @@map("match_handshakes")
}

model Match {
  id String @id @default(cuid())

  challengeId String?    @unique
  challenge   Challenge? @relation(fields: [challengeId], references: [id])

  equipoLocalId     String
  equipoLocal       Team   @relation("EquipoLocal", fields: [equipoLocalId], references: [id])
  equipoVisitanteId String
  equipoVisitante   Team   @relation("EquipoVisitante", fields: [equipoVisitanteId], references: [id])

  cantidadJugadores CantidadJugadores
  superficie        Superficie
  sedeId            String?
  sede              Venue?            @relation(fields: [sedeId], references: [id])

  estado EstadoPartido @default(FIRMADO)

  /// Codigo/QR del handshake: un lado lo genera, el otro lo consume. Los
  /// partidos de etapa 1 (presencial) lo traen desde la creacion; los de
  /// etapa 2 (pactados a distancia, ver Challenge) nacen sin codigo y lo
  /// reciben recien al "firmar en cancha" -- por eso es opcional.
  codigoHandshake         String?   @unique
  codigoHandshakeExpiraEn DateTime?

  /// Reporter por lado, fijado en el handshake (invariante: no se reasigna).
  reporterLocalId     String?
  reporterLocal       User?   @relation("ReporterLocal", fields: [reporterLocalId], references: [id])
  reporterVisitanteId String?
  reporterVisitante   User?   @relation("ReporterVisitante", fields: [reporterVisitanteId], references: [id])

  outcomeFinal OutcomePartido?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reportes        MatchReport[]
  asientosLedger  RatingLedger[]
  disputa         Dispute?
  eventosFairPlay FairPlayLedger[]
  incidentes      MatchIncidentFlag[]
  noShowFlags     MatchNoShowFlag[]

  @@map("matches")
}

/// Un reporte por lado (doble reporte independiente, §9). Si coinciden en
/// outcome, el partido liquida; el marcador puede diferir sin bloquear.
model MatchReport {
  id         String @id @default(cuid())
  matchId    String
  match      Match  @relation(fields: [matchId], references: [id])
  teamId     String
  team       Team   @relation(fields: [teamId], references: [id])
  reporterId String
  reporter   User   @relation(fields: [reporterId], references: [id])

  outcome     OutcomePartido
  golesLocal  Int?
  golesVisita Int?

  createdAt DateTime @default(now())

  @@unique([matchId, reporterId])
  @@map("match_reports")
}

/// Append-only: cada liquidacion agrega un asiento, nunca se edita ni borra.
/// El rating actual de un equipo se materializa a partir de estos asientos.
model RatingLedger {
  id      String @id @default(cuid())
  teamId  String
  team    Team   @relation(fields: [teamId], references: [id])
  matchId String
  match   Match  @relation(fields: [matchId], references: [id])

  delta                 Float
  ratingResultante      Float
  rdResultante          Float
  volatilidadResultante Float

  createdAt DateTime @default(now())

  @@index([teamId, createdAt])
  @@map("rating_ledger")
}

enum CapaDisputa {
  C1_EVIDENCIA
  C2_PLANTELES
  C3_ADMIN
}

/// Arbol de disputa por capas (concepto.md §10). Nace cuando el segundo
/// reporte discrepa del primero (Match pasa a EN_DISPUTA). Cada capa tiene
/// su propio vencimiento (capaExpiraEn); un job la hace avanzar si nadie
/// resolvio antes. El admin puede resolver en cualquier capa, no solo C3.
model Dispute {
  id      String @id @default(cuid())
  matchId String @unique
  match   Match  @relation(fields: [matchId], references: [id])

  capa CapaDisputa @default(C1_EVIDENCIA)

  /// Codigo unico que la foto de evidencia debe mostrar (anti-reciclaje de fotos viejas).
  nonce        String   @unique
  capaExpiraEn DateTime

  resuelta      Boolean         @default(false)
  /// Si resuelta y no anulada, el outcome que gano la disputa.
  resolucion    OutcomePartido?
  anulada       Boolean         @default(false)
  resueltaPorId String?
  resueltaPor   User?           @relation(fields: [resueltaPorId], references: [id])
  resueltaEn    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  evidencias        DisputeEvidence[]
  respuestasPlantel DisputePollRespuesta[]

  @@map("disputes")
}

/// Evidencia de C1: foto con el nonce de la disputa visible. Pesa mas que
/// cualquier voto (§10) — la resuelve el admin, no un conteo automatico.
model DisputeEvidence {
  id          String  @id @default(cuid())
  disputeId   String
  dispute     Dispute @relation(fields: [disputeId], references: [id])
  teamId      String
  team        Team    @relation(fields: [teamId], references: [id])
  subidoPorId String
  subidoPor   User    @relation(fields: [subidoPorId], references: [id])

  url         String
  descripcion String?

  createdAt DateTime @default(now())

  @@map("dispute_evidence")
}

enum RespuestaPoll {
  CONFIRMA_CAPITAN
  CONTRADICE_CAPITAN
}

/// Consulta al plantel de C2 — NO es una votacion vinculante (§10). Sirve
/// como señal para el admin: defeccion interna o evidencia que no se subio.
model DisputePollRespuesta {
  id           String  @id @default(cuid())
  disputeId    String
  dispute      Dispute @relation(fields: [disputeId], references: [id])
  teamId       String
  team         Team    @relation(fields: [teamId], references: [id])
  integranteId String
  integrante   User    @relation(fields: [integranteId], references: [id])

  respuesta  RespuestaPoll
  comentario String?

  createdAt DateTime @default(now())

  @@unique([disputeId, integranteId])
  @@map("dispute_poll_respuestas")
}

enum TipoEventoFairPlay {
  PARTIDO_LIMPIO
  GHOSTING
  REPORTE_FALSO_PROBADO
  DISPUTA_FRIVOLA
  INCIDENTE_FLAG
  NO_SHOW
}

/// Append-only, igual que RatingLedger (arquitectura.md: "ledger append-only
/// para rating y fair-play → auditable y reconstruible"). Team.fairPlay se
/// recalcula desde este historial completo (con decay temporal) cada vez
/// que se agrega un evento — nunca se edita ni borra un asiento.
model FairPlayLedger {
  id      String  @id @default(cuid())
  teamId  String
  team    Team    @relation(fields: [teamId], references: [id])
  matchId String?
  match   Match?  @relation(fields: [matchId], references: [id])

  tipo               TipoEventoFairPlay
  delta              Float
  fairPlayResultante Float

  createdAt DateTime @default(now())

  @@index([teamId, createdAt])
  @@map("fair_play_ledger")
}

/// Flag de incidente (agresion, concepto.md §11): NO adjudica quien tuvo la
/// culpa. Se pega al partido y ambos equipos reciben un delta simetrico —
/// la señal confiable es el agregado de flags de rivales DISTINTOS en el
/// tiempo, no un incidente aislado. Un flag por equipo por partido.
model MatchIncidentFlag {
  id                 String @id @default(cuid())
  matchId            String
  match              Match  @relation(fields: [matchId], references: [id])
  flaggeadoPorTeamId String
  flaggeadoPorTeam   Team   @relation(fields: [flaggeadoPorTeamId], references: [id])
  flaggeadoPorUserId String
  flaggeadoPorUser   User   @relation(fields: [flaggeadoPorUserId], references: [id])

  descripcion String?

  createdAt DateTime @default(now())

  @@unique([matchId, flaggeadoPorTeamId])
  @@map("match_incident_flags")
}

/// "El rival no aparecio" en un pacto a distancia (concepto.md §12,
/// Hito 5a). El acusado es implicitamente el otro equipo del partido --
/// cada equipo marca una sola vez (mismo patron de unicidad que
/// MatchIncidentFlag). Ver MatchesService.flaggearNoShow/resolverNoShowSiVence.
model MatchNoShowFlag {
  id                 String @id @default(cuid())
  matchId            String
  match              Match  @relation(fields: [matchId], references: [id])
  flaggeadoPorTeamId String
  flaggeadoPorTeam   Team   @relation(fields: [flaggeadoPorTeamId], references: [id])
  flaggeadoPorUserId String
  flaggeadoPorUser   User   @relation(fields: [flaggeadoPorUserId], references: [id])

  createdAt DateTime @default(now())

  @@unique([matchId, flaggeadoPorTeamId])
  @@map("match_no_show_flags")
}

/// De mejor a peor (concepto.md §6). No es un dato guardado por equipo: se
/// recalcula en cualquier momento cortando por percentil el ranking global
/// (ver RankingService.divisionDe) — no es una liga con tabla de puntos.
enum Division {
  ELITE
  ORO
  PLATA
  BRONCE
}

/// Temporada = año calendario (concepto.md §6). El rating perpetuo (y con
/// el, la division de cada equipo) nunca resetea. "cerrada" solo dispara un
/// snapshot de palmares (Campeonato) — no reasigna nada, no hay nada que
/// mover: la division siempre fue en vivo.
model Season {
  id          String    @id @default(cuid())
  anio        Int       @unique
  fechaInicio DateTime
  fechaFin    DateTime
  cerrada     Boolean   @default(false)
  cerradaEn   DateTime?

  campeonatos Campeonato[]

  @@map("seasons")
}

/// Palmares (concepto.md §6): 1° de cada division al cierre de temporada.
/// El campeon de Elite es ademas el campeon del año.
model Campeonato {
  id               String   @id @default(cuid())
  seasonId         String
  season           Season   @relation(fields: [seasonId], references: [id])
  division         Division
  teamId           String
  team             Team     @relation(fields: [teamId], references: [id])
  esCampeonDelAnio Boolean  @default(false)

  createdAt DateTime @default(now())

  @@unique([seasonId, division])
  @@map("campeonatos")
}
